{
  "name": "office-mermaid",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoker878/office-mermaid.git"
  },
  "license": "MIT",
  "config": {
    "app_to_debug": "word",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "dev-server": "vite",
    "dev:browser": "vite --mode browser",
    "typecheck": "tsc --noEmit",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "prettier": "office-addin-lint prettier",
    "signin": "office-addin-dev-settings m365-account login",
    "signout": "office-addin-dev-settings m365-account logout",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "watch": "vite build --mode development --watch"
  },
  "dependencies": {
    "pele": "^1.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/office-js": "^1.0.615",
    "@types/office-runtime": "^1.0.40",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint-plugin-office-addins": "^4.0.10",
    "office-addin-cli": "^2.0.10",
    "office-addin-debugging": "^6.1.2",
    "office-addin-dev-certs": "^2.0.10",
    "office-addin-lint": "^3.0.10",
    "office-addin-manifest": "^2.1.6",
    "office-addin-prettier-config": "^2.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "prettier": "office-addin-prettier-config",
  "browserslist": [
    "last 2 versions"
  ]
}
